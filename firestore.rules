rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function staffDoc() {
      return get(
        /databases/$(database)/documents/staff/$(request.auth.uid)
      );
    }

    function activeStaff() {
      return signedIn()
        && staffDoc().data.status == "Active";
    }

    function isSuperAdmin() {
      return activeStaff()
        && staffDoc().data.role == "Super Admin";
    }

    function hasPermission(permission) {
      return isSuperAdmin()
        || (
          activeStaff()
          && staffDoc().data.permissions[permission] == true
        );
    }

    // -------------------------
    // Staff
    // -------------------------
    match /staff/{uid} {
      allow read: if isSuperAdmin() || (signedIn() && request.auth.uid == uid);

      allow create: if isSuperAdmin();

      allow update: if isSuperAdmin()
        || (signedIn()
            && request.auth.uid == uid
            && request.resource.data.role == resource.data.role
            && request.resource.data.permissions == resource.data.permissions);

      allow delete: if isSuperAdmin();
    }

    // -------------------------
    // Orders
    // -------------------------
    match /orders/{orderId} {
      allow read: if hasPermission("orders");
      allow create, update: if hasPermission("orders");
      allow delete: if isSuperAdmin();
    }

    // -------------------------
    // Products
    // -------------------------
    match /products/{productId} {
      allow read: if hasPermission("products");
      allow create, update: if hasPermission("products");
      allow delete: if isSuperAdmin();
    }

    match /product_variants/{variantId} {
      allow read: if hasPermission("products") || hasPermission("inventory");
      allow create, update: if hasPermission("products") || hasPermission("inventory");
      allow delete: if isSuperAdmin();
    }

    // -------------------------
    // Inventory
    // -------------------------
    match /inventory/{id} {
      allow read, create, update: if hasPermission("inventory");
      allow delete: if isSuperAdmin();
    }

    // -------------------------
    // Customers
    // -------------------------
    match /customers/{customerId} {
      allow read, update: if hasPermission("customers");
      allow create: if hasPermission("customers");
      allow delete: if isSuperAdmin();
    }

    // -------------------------
    // Riders
    // -------------------------
    match /riders/{riderId} {
      allow read, update: if hasPermission("riders");
      allow create: if hasPermission("riders");
      allow delete: if isSuperAdmin();
    }

    // -------------------------
    // Payments
    // -------------------------
    match /payments/{paymentId} {
      allow read, update: if hasPermission("payments");
      allow create: if hasPermission("payments");
      allow delete: if isSuperAdmin();
    }

    // -------------------------
    // Refunds
    // -------------------------
    match /refunds/{refundId} {
      allow read, update: if hasPermission("refunds");
      allow create: if hasPermission("refunds");
      allow delete: if isSuperAdmin();
    }

    // -------------------------
    // Expenses
    // -------------------------
    match /expenses/{expenseId} {
      allow read, update: if hasPermission("expenses");
      allow create: if hasPermission("expenses");
      allow delete: if isSuperAdmin();
    }

    // -------------------------
    // Coupons
    // -------------------------
    match /coupons/{couponId} {
      allow read, update: if hasPermission("offers");
      allow create: if hasPermission("offers");
      allow delete: if isSuperAdmin();
    }

    // -------------------------
    // Reviews
    // -------------------------
    match /reviews/{reviewId} {
      allow read, update: if hasPermission("reviews");
      allow delete: if isSuperAdmin();
    }

    // -------------------------
    // Support
    // -------------------------
    match /support_tickets/{ticketId} {
      allow read, update: if hasPermission("support");
      allow create: if hasPermission("support");
      allow delete: if isSuperAdmin();

      match /messages/{messageId} {
        allow read, create: if hasPermission("support");
        allow update, delete: if isSuperAdmin();
      }
    }

    // -------------------------
    // Notifications
    // -------------------------
    match /notifications/{notificationId} {
      allow read, update: if hasPermission("notifications");
      allow create: if hasPermission("notifications");
      allow delete: if isSuperAdmin();
    }

    // -------------------------
    // Audit Logs
    // -------------------------
    match /audit_logs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if activeStaff();
      allow update, delete: if isSuperAdmin();
    }

    // -------------------------
    // Business Settings
    // -------------------------
    match /business_settings/{settingId} {
      allow read: if activeStaff();
      allow update: if hasPermission("settings");
      allow create: if hasPermission("settings");
      allow delete: if isSuperAdmin();
    }

    // -------------------------
    // Default deny
    // -------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
